    {
      "parameters": {
        "promptType": "define",
        "text": "=Name: {{ $('Save lead').item.json.fields.Name }}\nInterest: {{ $('Save lead').item.json.fields.Interest }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You write a short welcome email for a new lead.\n\nThe user message has a Name line and an Interest line.\n\nWrite one email with these rules:\n- 80 to 140 words\n- Simple English, warm and professional, like a person wrote it\n- Address them by their real name\n- Mention their interest once, in an ordinary sentence\n- One sentence offering help if they get stuck\n- One sentence inviting them to reply with questions\n- No subject line\n- No placeholders left in the text\n- No emojis\n- Do not say the message was written by an AI or by automation\n\nUse this shape:\n\nHi <name>,\n\n<welcome that includes their interest>\n\n<offer of support>\n\n<invitation to reply>\n\nBest regards,\nHafizflow Team\n"
        }
      },
